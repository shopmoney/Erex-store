rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products collection for Erex AI digital store:
    // - Public read access for visitors to browse publications
    // - Write access enabled for storefront catalog management
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Default fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

